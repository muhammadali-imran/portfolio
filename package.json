  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "stats": "node scripts/fetch-github.mjs",
    "lint:fix": "eslint . --fix",
    "verify": "node scripts/verify/run.mjs",
    "verify:list": "node scripts/verify/run.mjs --list",
