# Copy this file to .env and fill in your values. Restart `npm run dev` after editing.
# Only variables that start with VITE_ are exposed to the browser.

# Public URL of the deployed site (used for SEO and social previews)
VITE_SITE_URL=https://your-site.vercel.app

# Web3Forms access key: get one free at https://web3forms.com
# (Web3Forms keys are designed to be public; they only allow sending mail to your inbox.)
VITE_WEB3FORMS_KEY=

# Contact details. Leave empty to hide the matching button.
VITE_CONTACT_EMAIL=
# WhatsApp number in international format, digits only (no +, spaces or dashes)
VITE_WHATSAPP_NUMBER=

# Set to true after you add your CV file at public/Muhammad-Ali-CV.pdf
VITE_CV_AVAILABLE=false
